generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model InventoryItem {
  id                    Int              @id @default(autoincrement())
  name                  String
  quantity              Decimal?
  unit                  String           @default("ຫນ່ວຍ")
  costPerUnit           Decimal?
  reorderLevel          Decimal?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

enum MenuCategory {
  TUM
  GENERAL
}

model MenuItem {
  id           Int           @id @default(autoincrement())
  name         String
  price        Decimal
  category     MenuCategory  @default(GENERAL)
  isActive     Boolean       @default(true)
  lines        OrderLine[]
}

enum OrderStatus {
  DRAFT
  IN_KITCHEN
  AWAITING_PAYMENT
  PAID
  CANCELLED
}

model Order {
  id              Int               @id @default(autoincrement())
  code            String            @unique
  customerLabel   String?
  status          OrderStatus       @default(DRAFT)
  kitchenPrintedAt DateTime?
  mealReadyAt     DateTime?
  paidAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lines           OrderLine[]
  payments        PaymentLine[]
}

model OrderLine {
  id           Int       @id @default(autoincrement())
  orderId      Int
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId   Int
  menuItem     MenuItem  @relation(fields: [menuItemId], references: [id])
  qty          Int
  unitPrice    Decimal
  note         String?
}

enum PaymentMethod {
  CASH
  TRANSFER
}

model PaymentLine {
  id         Int           @id @default(autoincrement())
  orderId    Int
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method     PaymentMethod
  amount     Decimal
  createdAt  DateTime      @default(now())
}
